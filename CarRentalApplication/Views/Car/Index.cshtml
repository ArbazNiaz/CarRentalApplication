@model List<Car>

<html>
<body>
	<main>
		<h3 class="text-center p-3 ">Available Cars</h3>
		@if(Model.Count==0)
		{

		<div class="alert alert-info" role="alert">
			<p class="text-center text-dark fw-bold ">No Cars !</p>
		</div>
		}
		else
		{

		<div class="gap-10">
		@foreach(var car in Model)
			{
				<div class="card p-1 ">
					<div class="card-body d-flex flex-column gap-1 ">
						<div class="row justify-content-between">
							<div class="col-10">
						<h5 class="card-title">@car.Name</h5>
						<h6 class="card-subtitle text-muted "> Price : @car.Price PKR</h6>
							</div>
						<span class="badge rounded-pill text-bg-success p-1 align-content-center  col-2">Availiable</span>

						</div>
						<form asp-controller="Car" asp-route-targetId="@car.ID" asp-action="Book" method="post">
							<button type="submit" class="btn w-100 btn-primary shadow ">
								Book
							</button>
						</form>
						</div>
				</div>
			}
		</div>
		}
		</main>
</body>
</html>