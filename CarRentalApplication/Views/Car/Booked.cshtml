@model List<Car>

<html>
<body>
	<main class="container-fluid d-flex flex-column gap-2">
		<div class="row gap-2">
			<a href="/Car" class="col-2 text-center btn btn-primary "> Back to Cars</a>
			<h1 class="col-9 text-center">Booked Cars </h1>
		</div>
		@if(Model.Count==0)
			{
			<div class="alert alert-info" role="alert">
				<p class="text-center text-dark fw-bold ">No Booked Cars!</p>
			</div>
			}
			else
			{
				
			<table class="table table-striped table-hover">
			<thead class="table-dark">
				<tr>
					<th> ID</th>
					<th> Car Name</th>
					<th> Price Per Day</th>
					<th> Status</th>
				</tr>
			</thead>

		@foreach (var car in Model)
		{
				<tr>
					<td>
						@car.ID
					</td>
					<td>
						@car.Name
					</td>
					<td>
						@car.Price
					</td>
					<td >
						<span class="badge theme-warning bg-warning text-dark">

						Booked
						</span>
					</td>
			</tr>
		}
		</table>
			}
	</main>
</body>
</html>